{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  description: "DIRACGrid default Renovate policy. Repos adopt it with: \"extends\": [\"local>DIRACGrid/.github//renovate-config\"].",
  extends: ["config:recommended", "helpers:pinGitHubActionDigests"],
  // Supply-chain protection: do not adopt releases younger than 7 days.
  // Repos watching ghcr.io images may override this per packageRule: ghcr.io
  // exposes no release timestamps, so a minimumReleaseAge blocks those updates
  // entirely (see the diracx-charts config for an example).
  minimumReleaseAge: "7 days",
  // Keep pixi.lock files fresh: this is what makes dependency cooldowns
  // enforceable in pixi-based repos (the lock is only touched via reviewed PRs).
  lockFileMaintenance: {
    enabled: true,
  },
  packageRules: [
    {
      description: "Group pixi lockfile maintenance into a single PR",
      matchUpdateTypes: ["lockFileMaintenance"],
      matchManagers: ["pixi"],
      groupName: "pixi lockfile maintenance",
    },
    {
      description: "Group all GitHub Actions updates together",
      matchManagers: ["github-actions"],
      groupName: "GitHub Actions",
      labels: ["dependencies", "github-actions"],
    },
    {
      description: "Handle major version updates separately, never automerge",
      matchUpdateTypes: ["major"],
      groupName: "Major version updates",
      labels: ["breaking-change"],
      automerge: false,
    },
    {
      description: "Never automerge by default (repos may re-enable it per package)",
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: false,
    },
  ],
}
